rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper functions ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // chatId is "uidA_uidB" (sorted) - user is a member if uid is one half
    function isChatMember(chatId) {
      return isSignedIn() &&
        (request.auth.uid == chatId.split('_')[0] ||
         request.auth.uid == chatId.split('_')[1]);
    }
    // True if the only changed field is "reactions"
    function onlyReactionsChanged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['reactions']);
    }

    // ---- Users ----
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // Notifications: anyone signed in can create one for this user,
      // but only the owner can read / mark seen / delete
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn() &&
          request.resource.data.fromId == request.auth.uid;
      }

      // Followers - added/removed by the follower themselves
      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(followerId);
      }

      // Following - only the user manages their own list
      match /following/{followedId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
      }
    }

    // ---- Posts ----
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || onlyReactionsChanged());
      allow delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() &&
          (resource.data.userId == request.auth.uid || onlyReactionsChanged());
        allow delete: if isSignedIn() &&
          resource.data.userId == request.auth.uid;

        match /replies/{replyId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() &&
            request.resource.data.userId == request.auth.uid;
          allow update: if isSignedIn() &&
            (resource.data.userId == request.auth.uid || onlyReactionsChanged());
          allow delete: if isSignedIn() &&
            resource.data.userId == request.auth.uid;
        }
      }

      match /views/{viewerId} {
        allow read: if isSignedIn();
        allow create: if isOwner(viewerId);
        allow update, delete: if false;
      }
      match /saves/{saverId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(saverId);
        allow update: if false;
      }
      match /shares/{sharerId} {
        allow read: if isSignedIn();
        allow create: if isOwner(sharerId);
        allow update, delete: if false;
      }
    }

    // ---- Reposts (videos shared to a user's own profile) ----
    // Doc id is "{sharerUid}_{originalPostId}", but we check the sharedBy
    // field itself rather than parsing the id, same style as posts.userId.
    match /reposts/{repostId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.sharedBy == request.auth.uid;
      // Re-sharing (merge: true) re-writes the same doc, so update needs
      // the same owner check as create.
      allow update: if isSignedIn() &&
        resource.data.sharedBy == request.auth.uid &&
        request.resource.data.sharedBy == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.sharedBy == request.auth.uid;
    }

    // ---- Live streams (doc id is the host's own uid) ----
    match /liveStreams/{liveId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(liveId);

      // Anyone signed in can mark/unmark themselves as watching; only
      // the viewer themselves manages their own doc
      match /viewers/{viewerId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(viewerId);
        allow update: if false;
      }
    }

    // ---- Chats ----
    match /chats/{chatId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId) &&
          request.resource.data.senderId == request.auth.uid;
        // Recipient may only flip the "seen" flag
        allow update: if isChatMember(chatId) &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['seen']);
        // Only the sender can delete their own message
        allow delete: if isChatMember(chatId) &&
          resource.data.senderId == request.auth.uid;
      }

      // Typing / recording indicator - each user writes their own doc
      match /activity/{userId} {
        allow read: if isChatMember(chatId);
        allow write: if isChatMember(chatId) && isOwner(userId);
      }
    }

    // ---- Calls ----
    match /calls/{chatId} {
      allow read: if isSignedIn() &&
        (resource.data.callerId == request.auth.uid ||
         resource.data.calleeId == request.auth.uid);
      allow create: if isChatMember(chatId) &&
        request.resource.data.callerId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.callerId == request.auth.uid ||
         resource.data.calleeId == request.auth.uid);
      allow delete: if isSignedIn() &&
        (resource.data.callerId == request.auth.uid ||
         resource.data.calleeId == request.auth.uid);
    }

    // ---- Stories (auto-expire handled client-side via expiresAt) ----
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow update: if false;

      match /reactions/{reactorId} {
        allow read: if isSignedIn();
        allow write: if isOwner(reactorId);
      }
    }
  }
}
